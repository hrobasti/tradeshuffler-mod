{
  "schemaVersion": 1,
  "id": "${mod_id}",
  "version": "${version}",
  "name": "TradeShuffler",
  "description": "Re-roll the trades of villagers you have not traded with yet, and preview the trades they unlock at future levels.",
  "authors": [
    {
      "name": "kroet.net",
      "contact": {
        "homepage": "https://kroet.net"
      }
    }
  ],
  "license": "MIT",
  "icon": "assets/tradeshuffler/icon.png",
  "contact": {
    "homepage": "https://kroet.net",
    "sources": "https://github.com/hrobasti/tradeshuffler-mod",
    "issues": "https://github.com/hrobasti/tradeshuffler-mod/issues"
  },
  "environment": "*",
  "entrypoints": {
    "main": ["net.kroet.tradeshuffler.fabric.TradeShufflerFabricBootstrap"],
    "client": [
      "net.kroet.tradeshuffler.fabric.TradeShufflerFabricClientBootstrap"
    ],
    "modmenu": ["net.kroet.tradeshuffler.fabric.TradeShufflerModMenuApi"]
  },
  "mixins": ["tradeshuffler.mixins.json", "tradeshuffler.client.mixins.json"],
  "depends": {
    "fabricloader": ">=${fabric_loader_version}",
    "fabric-api": ">=${fabric_api_version}",
    "turtlelib": ">=${turtlelib_version}",
    "minecraft": "${minecraft_version}",
    "java": ">=${java_language_version}"
  },
  "suggests": {
    "modmenu": "*"
  },
  "custom": {
    "modmenu": {
      "links": {
        "modmenu.github_sponsors": "https://github.com/sponsors/hrobasti",
        "modmenu.kofi": "https://ko-fi.com/kroet"
      }
    }
  }
}
